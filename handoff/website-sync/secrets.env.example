# R02 sector dashboard deployment auth placeholders.
# Do not put real tokens in this file unless it is copied outside the repo
# and kept private.

# No project-specific API key is required by the current code.

# Optional only if local git credential manager is unavailable:
# GH_TOKEN=github_pat_xxx

# Not needed for normal deployment because Vercel deploys from GitHub integration:
# VERCEL_TOKEN=vercel_xxx

